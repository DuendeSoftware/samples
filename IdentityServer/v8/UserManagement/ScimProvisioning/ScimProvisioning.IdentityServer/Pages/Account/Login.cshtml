@page
@model ScimProvisioning.IdentityServer.Pages.Account.LoginModel
<h1>Sign in as a provisioned user</h1>
<p>First provision an employee from the simulated Directory. The SCIM userName must be an email address for this demo.</p>
<p>This flow never creates a profile. It binds email OTP to the existing provisioned subject.</p>
<form method="post">
    <div asp-validation-summary="All"></div>
    <label asp-for="Email">Provisioned userName</label>
    <input asp-for="Email" type="email" autocomplete="username" required />
    <button type="submit">Send code to Mailpit</button>
</form>
