<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SCIM destination</title>
    <style>
        body { font: 1rem system-ui; max-width: 75rem; margin: 2rem auto; padding: 0 1rem; }
        nav { display: flex; gap: 1rem; align-items: center; }
        table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
        th, td { text-align: left; padding: .6rem; border: 1px solid #bbb; overflow-wrap: anywhere; }
        input, button { padding: .5rem; margin: .3rem; }
        .validation-summary-errors, .error { color: #a00; }
        code { overflow-wrap: anywhere; }
    </style>
</head>
<body>
    <nav>
        <a asp-page="/Index">Destination users and groups</a>
        <a asp-page="/Account/Login">OTP sign-in</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-page="/Account/Logout" method="post"><button type="submit">Sign out</button></form>
        }
    </nav>
    <p><strong>Local demonstration only.</strong> These read-only directory views are not production administration pages.</p>
    <main>@RenderBody()</main>
</body>
</html>
